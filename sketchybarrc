PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
SPOTIFY_EVENT="com.spotify.client.PlaybackStateChanged"

##### Bar #####

sketchybar --bar \
height=38 \
margin=0 \
corner_radius=14 \
position=top \
color=0xdd1c1815 \
border_width=1 \
border_color=0x18ffffff \
blur_radius=34 \
topmost=on \
sticky=on \
y_offset=0

##### Defaults #####

sketchybar --default \
label.font="SF Pro:Semibold:14.0" \
label.color=0xfff5e0dc \
icon.font="SF Pro:Bold:14.0" \
icon.color=0xfff5e0dc \
icon.y_offset=1 \
padding_left=8 \
padding_right=8 \
label.padding_left=6 \
label.padding_right=6 \
icon.padding_left=6 \
icon.padding_right=6 \
background.height=28 \
background.corner_radius=8

##### Items #####

sketchybar \
\
--add item apple left \
--set apple \
icon=􀣺 \
icon.font="SF Pro:Bold:18.0" \
icon.padding_left=2 \
icon.padding_right=14 \
click_script="open -a 'Raycast'" \
\
--add event spotify_update $SPOTIFY_EVENT \
\
--add item spotify.art left \
--set spotify.art \
script="$PLUGIN_DIR/spotify_artwork.sh" \
update_freq=1 \
width=34 \
icon.drawing=off \
label.drawing=off \
background.drawing=on \
background.height=32 \
background.corner_radius=10 \
background.padding_left=1 \
background.padding_right=1 \
\
--subscribe spotify.art system_woke \
\
--add item spotify left \
--set spotify \
script="$PLUGIN_DIR/spotify.sh" \
icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
icon.color=0xff1DB954 \
icon.y_offset=0 \
label.font="SF Pro:Semibold:14.0" \
label.max_chars=40 \
label.padding_left=6 \
label.padding_right=10 \
\
--subscribe spotify \
    spotify_update \
    mouse.entered.global \
    mouse.exited.global \
\
--add item spotify.back left \
--set spotify.back \
script="$PLUGIN_DIR/spotify.sh" \
drawing=off \
icon=􀊊 \
icon.font="SF Pro:Bold:16.0" \
icon.color=0xff1DB954 \
\
--subscribe spotify.back mouse.clicked \
\
--add item spotify.playpause left \
--set spotify.playpause \
script="$PLUGIN_DIR/spotify.sh" \
drawing=off \
icon.font="SF Pro:Bold:16.0" \
icon.color=0xff1DB954 \
\
--subscribe spotify.playpause mouse.clicked \
\
--add item spotify.forward left \
--set spotify.forward \
script="$PLUGIN_DIR/spotify.sh" \
drawing=off \
icon=􀊌 \
icon.font="SF Pro:Bold:16.0" \
icon.color=0xff1DB954 \
\
--subscribe spotify.forward mouse.clicked \
\
--add item clock right \
--set clock \
update_freq=10 \
icon=􀐬 \
icon.font="SF Pro:Bold:15.0" \
icon.padding_left=8 \
icon.padding_right=6 \
label.padding_left=2 \
label.padding_right=10 \
padding_left=8 \
padding_right=8 \
script="$PLUGIN_DIR/clock.sh" \
\
--add item battery right \
--set battery \
script="$PLUGIN_DIR/battery.sh" \
icon.font="SF Pro:Bold:15.0" \
icon.padding_left=8 \
icon.padding_right=6 \
label.padding_left=2 \
label.padding_right=8 \
padding_left=8 \
padding_right=8 \
update_freq=30 \
\
--subscribe battery \
    system_woke \
    power_source_change \
\
--add item volume right \
--set volume \
script="$PLUGIN_DIR/volume.sh" \
icon.font="SF Pro:Bold:15.0" \
icon.padding_left=8 \
icon.padding_right=6 \
label.padding_left=2 \
label.padding_right=8 \
padding_left=8 \
padding_right=8 \
update_freq=2 \
\
--subscribe volume \
    volume_change \
    system_woke \
\
--add item wifi right \
--set wifi \
script="$PLUGIN_DIR/wifi.sh" \
icon.font="SF Pro:Bold:15.0" \
icon.padding_left=8 \
icon.padding_right=8 \
padding_left=8 \
padding_right=8 \
update_freq=10 \
\
--subscribe wifi \
    wifi_change \
    system_woke \
\
--add item cpu right \
--set cpu \
script="$PLUGIN_DIR/cpu.sh" \
icon.font="SF Pro:Bold:15.0" \
icon.padding_left=8 \
icon.padding_right=6 \
label.padding_left=2 \
label.padding_right=8 \
padding_left=8 \
padding_right=8 \
update_freq=2 \
\
--subscribe cpu system_woke

##### Spotify Capsule #####

sketchybar \
--add bracket spotify_group \
    spotify.art \
    spotify \
    spotify.back \
    spotify.playpause \
    spotify.forward \
\
--set spotify_group \
background.color=0xdd242731 \
background.corner_radius=13 \
background.height=32 \
background.padding_left=6 \
background.padding_right=6 \
background.border_width=1 \
background.border_color=0x14f2e0c8 \
shadow.drawing=on \
shadow.color=0x40000000 \
shadow.distance=2 \
shadow.angle=270

##### Status Capsule #####

sketchybar \
--add bracket status_group \
    cpu \
    wifi \
    volume \
    battery \
    clock \
\
--set status_group \
background.color=0xdd242731 \
background.corner_radius=13 \
background.height=32 \
background.padding_left=6 \
background.padding_right=6 \
background.border_width=1 \
background.border_color=0x14f2e0c8 \
shadow.drawing=on \
shadow.color=0x40000000 \
shadow.distance=2 \
shadow.angle=270

##### Refresh #####

sketchybar --update
