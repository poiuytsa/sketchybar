# ---------- Visualizer ----------
# Each bar is its own independent sketchybar item, updated directly by the
# Swift daemon via `sketchybar --set spotify.visN ...`. No script/subscribe
# needed here since nothing in sketchybar's event system drives these.
for i in $(seq 1 9); do
  sketchybar --add item "spotify.vis$i" left
  vis_padding_right=0
  if [ "$i" = "9" ]; then
    vis_padding_right=6   # extra clearance so the capsule's rounded corner doesn't clip the last bar
  fi
  sketchybar --set "spotify.vis$i" \
    icon.drawing=off \
    label="▁" \
    label.font="JetBrainsMono Nerd Font:Regular:12.0" \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left=0 \
    padding_right="$vis_padding_right" \
    width=9
done

NOTCH_GEOM=$(swift -e '
import AppKit
if let s = NSScreen.screens.first {
  let l = s.auxiliaryTopLeftArea?.width ?? 0
  let r = s.auxiliaryTopRightArea?.width ?? 0
  print(Int(l))
  print(Int(s.frame.width - r))
}
' 2>/dev/null)

NOTCH_START=$(echo "$NOTCH_GEOM" | sed -n '1p')
NOTCH_END=$(echo "$NOTCH_GEOM" | sed -n '2p')

if [ -z "$NOTCH_START" ] || [ -z "$NOTCH_END" ] || [ "$NOTCH_END" -le "$NOTCH_START" ] 2>/dev/null; then
  # Fallback measured on this machine — re-measure if display/res changes.
  NOTCH_START=646
  NOTCH_END=825
fi
NOTCH_WIDTH=$((NOTCH_END - NOTCH_START))

echo "$NOTCH_START" > "$HOME/.config/sketchybar/.notch_start"

# ---------- Progress bar ----------
# Two adjacent thin background bars (fill + track) are resized every tick
# by spotify_progress.sh so together they read as one line growing
# left-to-right with playback position. spotify.progress is an invisible
# driver item (width=0) that owns the script/update_freq so the two visible
# bars aren't each independently re-triggering osascript calls.
# Added AFTER notch.spacer above, so it renders in guaranteed-clear space
# to the right of the physical camera cutout instead of partially
# underneath it.

sketchybar --add item spotify.progress.spacer left
sketchybar --set spotify.progress.spacer \
  icon.drawing=off \
  label.drawing=off \
  width=20

sketchybar --add item spotify.progress.fill left
sketchybar --set spotify.progress.fill \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=on \
  background.color=0xff1DB954 \
  background.height=3 \
  background.corner_radius=1 \
  padding_left=6 \
