# ---------- Visualizer ----------
# Each bar is its own independent sketchybar item, updated directly by the
# Swift daemon via `sketchybar --set spotify.visN ...`. No script/subscribe
# needed here since nothing in sketchybar's event system drives these.
for i in $(seq 1 9); do
  sketchybar --add item "spotify.vis$i" left
  vis_padding_right=0
  if [ "$i" = "9" ]; then
    vis_padding_right=6   # extra clearance so the capsule's rounded corner doesn't clip the last bar
  fi
  sketchybar --set "spotify.vis$i" \
    icon.drawing=off \
    label="▁" \
    label.font="JetBrainsMono Nerd Font:Regular:12.0" \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left=0 \
    padding_right="$vis_padding_right" \
    width=9
done

# ---------- Notch spacer ----------
# sketchybar has no notch awareness on its own — it just lays items out
# left-to-right, so a wide left group can end up rendering underneath the
# physical camera cutout. Apple + spotify stay tight together as one block;
# this spacer creates the blank gap after them so the status icons on the
# right (which are anchored from the right edge already) end up clear of
# the notch instead of the spotify group running into it. NOTCH_WIDTH is
# queried live so it's correct on any notched MacBook; falls back to a sane
# default if jq isn't installed.
NOTCH_WIDTH=$(sketchybar --query bar 2>/dev/null | command -v jq >/dev/null 2>&1 && sketchybar --query bar | jq -r '.notch_width // 0')
if [ -z "$NOTCH_WIDTH" ] || [ "$NOTCH_WIDTH" = "0" ]; then
  NOTCH_WIDTH=150   # adjust to taste if your menu bar layout still overlaps
fi

sketchybar --add item notch.spacer left
sketchybar --set notch.spacer \
  icon.drawing=off \
  label.drawing=off \
  width="$NOTCH_WIDTH"

